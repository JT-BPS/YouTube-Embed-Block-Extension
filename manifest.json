{
  "manifest_version": 3,
  "name": "Slides YT Fix",
  "description": "Keeps teacher-embedded YouTube and Drive videos playing in Google Slides while blocking YouTube search, URL embedding, and link previews in Docs, Sheets, and Slides.",
  "version": "1.8.1",

  "update_url": "https://jt-bps.github.io/YouTube-Embed-Block-Extension/update.xml",

  "permissions": [
    "declarativeNetRequest"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "host_permissions": [
    "https://docs.google.com/*",
    "https://*.youtube.com/*",
    "https://*.youtube-nocookie.com/*"
  ],

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_youtube_search",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*",
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/picker*",
        "https://*.youtube.com/*",
        "https://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
